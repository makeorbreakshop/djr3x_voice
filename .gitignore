# Test files and directories
# FIXED 2026-09-17: these were unanchored, so `test_*.py` ignored the ENTIRE real test
# suite under cantina_os/tests/ - every existing test file had to be force-added, and any
# newly written test was invisible to `git status` and silently left out of commits.
# Now anchored to the throwaway scratch scripts that actually live at the repo root and
# at cantina_os/ top level; cantina_os/tests/ is tracked normally.
/test_*.py
/test_*.json
/cantina_os/test_*.py
batch_test_results_*.json
tests/data/
test_articles/
test_batch_jsonl/
test_vectors/
.coverage

# Log files
*.log
latest_run.log
# logs/ - REMOVED: We now commit runtime logs for debugging

# Vector files and directories
e5_vectors/
e5_vectors_full/
bert_embeddings.jsonl
bert_sample.json
vector_creation_*/
processed_ids.txt

# Checkpoint and backup files
*_checkpoint.json
*_checkpoint.json.bak.*
data/
path/

