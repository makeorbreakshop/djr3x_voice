# Third-party reference code without a licence (grnwave's DJ-RexBody sample): never commit
mech/vendor/grnwave/

# Rolled-aside virtualenvs (see chore(deps) 2026-09-17)
venv.old-*/

# Runtime conversation memory (contains personal data; never commit)
/cantina_os/memory_data/

# ./r3x dependency-install checksum stamp
cantina_os/.requirements_installed

# Phase 0 bus-tap session logs (large, per run)
logs/session-*.jsonl

# Rust crate test data is committed
!rust/crates/*/tests/data/

# mech/ - vendored third-party CAD (licensed, never commit), venv, local renders
mech/vendor/
mech/.venv/
mech/out/
# transcriptions of the kit's group-only guide (licensed); regenerate locally
mech/assemblies/kit/_guide/

# mech/parts is our parts library (the Python template above ignores parts/)
!mech/parts/
