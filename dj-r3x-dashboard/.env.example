# Spotify Web Playback SDK Configuration
# These must be prefixed with NEXT_PUBLIC_ to be accessible in the browser
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=your_spotify_client_id_here
NEXT_PUBLIC_SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/redirect

# Bridge API Configuration
NEXT_PUBLIC_BRIDGE_URL=http://localhost:8000

# Environment
NODE_ENV=development