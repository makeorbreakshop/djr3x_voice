      "support": "driven"
    },
    {
      "id": "chest_strip",
      "model": "33 x WS2812B",
      "role": "3 panels x (8 LED holes + 3 windows)",
      "dims_mm": [
        120.0,
        60.0,
        3.0
      ],
      "mount": {
        "bracket": "MS_P_1_Full logic panels (x3), from behind",
        "link": "torso_middle",
        "t": [
          -0.12,
          0.453,
          0.09
        ],
        "q": [
          0,
          0,
          0,
          1
        ]
      },
      "connectors": [
        {
          "id": "din",
          "kind": "solder_pad",
          "pins": [
