    {
      "id": "servo_ctl",
      "model": "Raspberry Pi Pico (RP2040) + INA219 + rail MOSFET",
      "role": "18 servo channels (16 PWM + 2 PIO), goals at event time",
      "url": "https://www.raspberrypi.com/products/raspberry-pi-pico/",
      "dims_mm": [
        51.0,
        21.0,
        4.0
      ],
      "mount": {
        "bracket": "base electronics plate",
        "link": "torso_lower",
        "t": [
          0.0,
          0.08,
          0.0
        ],
        "q": [
          0,
          0,
          0,
          1
        ],
        "inferred": true,
        "inferred_note": "Mounting in the base is not recorded; placed on the base plate."
      },
      "connectors": [
        {
          "id": "usb",
          "kind": "usb_micro_b",
          "pins": [
            "VBUS",
            "D-",
            "D+",
            "GND"
          ],
          "note": "CDC, R3X_SERVO_PORT"
        },
        {
          "id": "servo",
          "kind": "servo_3p_2.54 x18",
          "pins": [
            "GPIO0..GPIO17",
            "6V",
            "GND"
          ]
        },
        {
          "id": "i2c",
          "kind": "dupont_4p_2.54",
          "pins": [
            "GPIO20 SDA",
            "GPIO21 SCL",
            "3V3",
            "GND"
          ],
